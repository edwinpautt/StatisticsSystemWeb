<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <title>Configuración - Statistics System</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
        }

        header {
            background-color: #1f4e78;
            color: white;
            padding: 25px 40px;
        }

        .contenedor {
            width: 90%;
            max-width: 1100px;
            margin: 40px auto;
        }

        .tarjeta {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .opcion {
            border-bottom: 1px solid #ddd;
            padding: 20px 0;
        }

        .opcion:last-child {
            border-bottom: none;
        }

        .boton {
            display: inline-block;
            padding: 10px 18px;
            margin-top: 10px;
            background-color: #1f4e78;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

    </style>

</head>

<body>

<header>

    <h1>Statistics System</h1>

    <p>Configuración del sistema</p>

</header>


<div class="contenedor">


    <div class="tarjeta">

        <h2>Configuración</h2>


        <div class="opcion">

            <h3>Programas académicos</h3>

            <p>
                Administración de los programas académicos
                utilizados en los registros.
            </p>

            <a class="boton" href="#">
                Administrar
            </a>

        </div>


        <div class="opcion">

            <h3>Asignaturas</h3>

            <p>
                Administración de las asignaturas
                disponibles para el registro.
            </p>

            <a class="boton" href="#">
                Administrar
            </a>

        </div>


        <div class="opcion">

            <h3>Docentes</h3>

            <p>
                Administración de docentes asociados
                a las prácticas de laboratorio.
            </p>

            <a class="boton" href="#">
                Administrar
            </a>

        </div>


        <div class="opcion">

            <h3>Áreas</h3>

            <p>
                Administración de las áreas de los
                laboratorios de simulación clínica.
            </p>

            <a class="boton" href="#">
                Administrar
            </a>

        </div>


        <div class="opcion">

            <h3>Horarios</h3>

            <p>
                Administración de los horarios utilizados
                para las prácticas.
            </p>

            <a class="boton" href="#">
                Administrar
            </a>

        </div>

    </div>


    <a class="boton"
       href="index.jsp">

        Volver al inicio

    </a>

</div>

</body>

</html>